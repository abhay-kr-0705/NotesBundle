generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// User model with interests for recommendations
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          Role      @default(USER)
  interests     String[]  // Array of category slugs for recommendations
  phone         String?
  otp           String?
  otpExpiry     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  cart          CartItem[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Categories for organizing notes
model Category {
  id          String        @id @default(cuid())
  name        String
  slug        String        @unique
  description String?
  icon        String?       // Icon name or emoji
  image       String?
  parentId    String?
  parent      Category?     @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[]    @relation("SubCategories")
  notes       Note[]
  order       Int           @default(0) // Display order (lower comes first)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// Notes/Study Materials
model Note {
  id              String      @id @default(cuid())
  title           String
  slug            String      @unique
  description     String      @db.Text
  shortDescription String?
  price           Float       @default(0) // 0 means free
  discountPrice   Float?
  fileUrl         String?     // PDF or file URL
  externalUrl     String?     // Direct external link (e.g. Google Drive)
  previewUrl      String?     // Preview PDF URL (limited pages)
  previewImages   String[]    // Array of image URLs for manual preview pages
  previewPages    Int         @default(5) // Number of pages available for preview
  thumbnailUrl    String?
  categoryId      String
  category        Category    @relation(fields: [categoryId], references: [id])
  tags            String[]
  examType        String?     // GATE, SSC, Railway, etc.
  university      String?     // BEU, etc.
  semester        Int?        // For semester notes
  branch          String?     // CSE, ECE, ME, etc.
  subject         String?
  language        String      @default("English")
  pages           Int?
  fileSize        String?
  format          String      @default("PDF")
  isFeatured      Boolean     @default(false)
  isPublished     Boolean     @default(true)
  downloadCount   Int         @default(0)
  viewCount       Int         @default(0)
  averageRating   Float       @default(0)
  totalReviews    Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orderItems      OrderItem[]
  reviews         Review[]
  wishlistItems   WishlistItem[]
  cartItems       CartItem[]
  pageViews       PageView[]
}

// Orders
model Order {
  id              String      @id @default(cuid())
  userId          String
  user            User        @relation(fields: [userId], references: [id])
  totalAmount     Float
  discountAmount  Float       @default(0)
  finalAmount     Float
  status          OrderStatus @default(PENDING)
  paymentId       String?     // Razorpay payment ID
  razorpayOrderId String?     // Razorpay order ID
  couponId        String?
  coupon          Coupon?     @relation(fields: [couponId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id])
  price     Float
  createdAt DateTime @default(now())
}

// Reviews
model Review {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5
  comment   String?  @db.Text
  isVerified Boolean @default(false) // Verified purchase
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, noteId])
}

// Wishlist
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, noteId])
}

// Cart
model CartItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, noteId])
}

// Coupons
model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  description   String?
  discountType  DiscountType
  discountValue Float     // Percentage or flat amount
  minOrderValue Float?
  maxDiscount   Float?    // Max discount for percentage coupons
  usageLimit    Int?
  usedCount     Int       @default(0)
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orders        Order[]
}

// Page Views for Analytics
model PageView {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())
}

// Site Analytics
model Analytics {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date
  totalViews  Int      @default(0)
  uniqueViews Int      @default(0)
  totalSales  Int      @default(0)
  revenue     Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Site Settings (key-value store)
model SiteSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

